# Public URL used by OAuth callbacks.
COWTRACK_PUBLIC_URL=http://127.0.0.1:7860

# Google Cloud OAuth 2.0 Web application credentials.
COWTRACK_GOOGLE_CLIENT_ID=
COWTRACK_GOOGLE_CLIENT_SECRET=

# Sign in with Apple Web credentials. Apple requires a Services ID, an
# associated App ID, an HTTPS domain and a generated client-secret JWT.
COWTRACK_APPLE_CLIENT_ID=
COWTRACK_APPLE_CLIENT_SECRET=

# Optional unattended Telegram delivery. Without these values CowTrack uses
# Telegram's official share screen and asks the user to choose the recipient.
COWTRACK_TELEGRAM_BOT_TOKEN=
COWTRACK_TELEGRAM_CHAT_ID=
