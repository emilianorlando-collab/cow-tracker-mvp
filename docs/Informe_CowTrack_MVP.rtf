\f3\b0\fs17 \cf6 from ultralytics import YOLO
\f2\fs24 \cf0 \uc0\u8232 
\f3\fs17 \cf6 import cv2
\f2\fs24 \cf0 \uc0\u8232 \u8232 
\f3\fs17 \cf6 detector = YOLO('scripts/yolov8m.pt')
\f2\fs24 \cf0 \uc0\u8232 
\f3\fs17 \cf6 video = cv2.VideoCapture('datos/video_campo_erondina.mp4')
\f2\fs24 \cf0 \uc0\u8232 \u8232 
\f3\fs17 \cf6 while True:
\f2\fs24 \cf0 \uc0\u8232 
\f3\fs17 \cf6     ok, frame = video.read()
\f2\fs24 \cf0 \uc0\u8232 
\f3\fs17 \cf6     if not ok:
\f2\fs24 \cf0 \uc0\u8232 
\f3\fs17 \cf6         break
\f2\fs24 \cf0 \uc0\u8232 
\f3\fs17 \cf6     detections = detector.track(frame, persist=True)
\f2\fs24 \cf0 \uc0\u8232 
\f3\fs17 \cf6     # 1) recortar vacas detectadas
\f2\fs24 \cf0 \uc0\u8232 
\f3\fs17 \cf6     # 2) extraer embeddings con mi_modelo_reid.pt
\f2\fs24 \cf0 \uc0\u8232 
\f3\fs17 \cf6     # 3) comparar contra galer\'eda Erondina
\f2\fs24 \cf0 \uc0\u8232 
\f3\fs17 \cf6     # 4) sostener identidad por continuidad temporal
\f2\fs24 \cf0 \uc0\u8232 \u8232 
\f3\fs17 \cf6 video.release()\cell \lastrow\row
